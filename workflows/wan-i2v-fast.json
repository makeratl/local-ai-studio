{
  "1": {
    "inputs": {
      "image": "{{input_image}}"
    },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Image" }
  },
  "10": {
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" }
  },
  "20": {
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP" }
  },
  "21": {
    "inputs": {
      "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model (Low Noise)" }
  },
  "22": {
    "inputs": {
      "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model (High Noise)" }
  },
  "23": {
    "inputs": {
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
      "strength_model": 1.0,
      "model": ["21", 0]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Load LoRA (Low Noise)" }
  },
  "24": {
    "inputs": {
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
      "strength_model": 1.0,
      "model": ["22", 0]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Load LoRA (High Noise)" }
  },
  "25": {
    "inputs": {
      "shift": 5.0,
      "model": ["24", 0]
    },
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "ModelSamplingSD3 (High Noise+LoRA)" }
  },
  "26": {
    "inputs": {
      "shift": 5.0,
      "model": ["23", 0]
    },
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "ModelSamplingSD3 (Low Noise+LoRA)" }
  },
  "27": {
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["20", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Positive)" }
  },
  "28": {
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["20", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Negative)" }
  },
  "29": {
    "inputs": {
      "width": 640,
      "height": 640,
      "length": 81,
      "batch_size": 1,
      "positive": ["27", 0],
      "negative": ["28", 0],
      "vae": ["10", 0],
      "start_image": ["1", 0]
    },
    "class_type": "WanImageToVideo",
    "_meta": { "title": "WanImageToVideo" }
  },
  "30": {
    "inputs": {
      "add_noise": "enable",
      "noise_seed": "{{seed}}",
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable",
      "model": ["25", 0],
      "positive": ["29", 0],
      "negative": ["29", 1],
      "latent_image": ["29", 2]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": { "title": "KSampler Stage 1 (High Noise+LoRA)" }
  },
  "31": {
    "inputs": {
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 2,
      "end_at_step": 4,
      "return_with_leftover_noise": "disable",
      "model": ["26", 0],
      "positive": ["29", 0],
      "negative": ["29", 1],
      "latent_image": ["30", 0]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": { "title": "KSampler Stage 2 (Low Noise+LoRA)" }
  },
  "32": {
    "inputs": {
      "samples": ["31", 0],
      "vae": ["10", 0]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "33": {
    "inputs": {
      "fps": 16,
      "images": ["32", 0]
    },
    "class_type": "CreateVideo",
    "_meta": { "title": "Create Video" }
  },
  "34": {
    "inputs": {
      "filename_prefix": "{{filename_prefix}}",
      "format": "mp4",
      "codec": "h264",
      "video": ["33", 0]
    },
    "class_type": "SaveVideo",
    "_meta": { "title": "Save Video" }
  }
}