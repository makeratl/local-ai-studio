{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "H3 FL2VA model"},
        "inputs": {"unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "Turbo 8-step LoRA"},
        "inputs": {"lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors", "strength_model": 1.0, "model": ["1", 0]}},
  "3": {"class_type": "CLIPLoader", "_meta": {"title": "Qwen3-VL 32B text encoder"},
        "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}},
  "4": {"class_type": "VAELoader", "_meta": {"title": "H3 video VAE"},
        "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
  "5": {"class_type": "VAELoader", "_meta": {"title": "H3 audio VAE"},
        "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},

  "10": {"class_type": "RandomNoise", "inputs": {"noise_seed": 42}},
  "11": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
  "12": {"class_type": "BasicScheduler",
         "inputs": {"scheduler": "simple", "steps": 8, "denoise": 1.0, "model": ["2", 0]}},
  "13": {"class_type": "BasicGuider", "inputs": {"model": ["2", 0], "conditioning": ["20", 0]}},
  "14": {"class_type": "SamplerCustomAdvanced",
         "inputs": {"noise": ["10", 0], "guider": ["13", 0], "sampler": ["11", 0], "sigmas": ["12", 0], "latent_image": ["20", 1]}},

  "20": {"class_type": "MiniMaxH3ImageToVideo", "_meta": {"title": "H3 conditioning (T2V: no frames)"},
         "inputs": {
           "clip": ["3", 0], "vae": ["4", 0],
           "prompt": "Warm documentary look, handheld 35mm, late afternoon light.\nSHOT 1: A cluttered maker workshop; an old man in a leather apron taps a brass gear into a clockwork bird on the bench, the camera slowly pushing in.\nSHOT 2: Close-up as the bird's wings twitch, then flutter open with a soft mechanical whir.\nAudio: ticking clocks in the room, a small metallic click as the gear seats, rising wind-up whir, a single chirp from the bird at the end.",
           "width": 1344, "height": 768, "length": 124}},

  "50": {"class_type": "VAEDecode", "inputs": {"samples": ["14", 0], "vae": ["4", 0]}},
  "51": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["14", 0], "vae": ["5", 0]}},
  "52": {"class_type": "CreateVideo", "inputs": {"fps": 24, "bit_depth": 8, "images": ["50", 0], "audio": ["51", 0]}},
  "53": {"class_type": "SaveVideo",
         "inputs": {"filename_prefix": "video/MiniMaxH3_t2v", "format": "mp4", "codec": "h264", "codec.encoding": "auto", "video": ["52", 0]}}
}
