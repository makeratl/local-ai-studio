{
  "id": "qwen-full-lora",
  "display_name": "Qwen Full Quality with Style LoRA",
  "category": "text-to-image",
  "description": "Qwen base model with style LoRA applied. Full quality with custom style.",
  "source_file": "qwen-full-lora.json",
  "seed_node": 3,
  "output": {
    "save_node": 9,
    "save_param": "filename_prefix"
  },
  "parameters": {
    "prompt": {
      "node": "6",
      "input": "text",
      "type": "STRING",
      "required": true
    },
    "negative_prompt": {
      "node": "7",
      "input": "text",
      "type": "STRING",
      "default": ""
    },
    "aspect_ratio": {
      "node": "5",
      "input": "aspect_ratio",
      "type": "COMBO",
      "default": "1:1 Square",
      "options": [
        "1:1 Square",
        "16:9 Landscape",
        "9:16 Portrait",
        "4:3 Landscape",
        "3:4 Portrait",
        "3:2 Landscape",
        "2:3 Portrait"
      ]
    },
    "batch_size": {
      "node": "5",
      "input": "batch_size",
      "type": "INT",
      "default": 1,
      "min": 1,
      "max": 4
    },
    "steps": {
      "node": "3",
      "input": "steps",
      "type": "INT",
      "default": 50,
      "min": 10,
      "max": 50
    },
    "cfg": {
      "node": "3",
      "input": "cfg",
      "type": "FLOAT",
      "default": 4.0,
      "min": 1.0,
      "max": 10.0
    },
    "style_lora_name": {
      "node": "14",
      "input": "lora_name",
      "type": "COMBO",
      "dynamic_options": true,
      "description": "Style LoRA filename, as shown by list_loras",
      "required": true
    },
    "style_lora_strength": {
      "node": "14",
      "input": "strength_model",
      "type": "FLOAT",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    }
  },
  "default_filename_prefix": "Qwen-Full-LoRA",
  "seed_param": "seed"
}
